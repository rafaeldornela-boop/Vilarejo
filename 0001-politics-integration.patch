diff --git a/style.css b/style.css
--- a/style.css
+++ b/style.css
@@ -326,1 +326,31 @@
 .feed-list li:last-child { border-bottom: 0; }
+.politics-host { min-width: 0; }
+.politics-dashboard { display: grid; gap: 15px; }
+.politics-summary-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
+.politics-summary-card { min-width: 0; padding: 15px 17px; border: 1px solid var(--line); border-radius: 11px; background: var(--paper); }
+.politics-summary-card span { display: block; color: #87948a; font-size: 9px; font-weight: 700; }
+.politics-summary-card strong { display: block; margin-top: 5px; color: var(--forest); font: 800 21px var(--heading); }
+.politics-section-heading { margin: 5px 0 0; }
+.politics-section-heading h2 { margin: 4px 0; color: var(--forest); font: 800 18px var(--heading); }
+.politics-section-heading p { max-width: 760px; color: var(--muted); font-size: 10px; }
+.politics-groups-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
+.politics-group-card { min-width: 0; padding: 16px 17px; border: 1px solid var(--line); border-radius: 11px; background: var(--paper); box-shadow: var(--shadow); }
+.politics-group-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
+.politics-group-head h3 { margin: 0; color: var(--forest); font: 800 14px var(--heading); }
+.politics-group-head p { margin: 4px 0 0; color: var(--muted); font-size: 9px; line-height: 1.45; }
+.politics-relation { flex: 0 0 auto; padding: 5px 8px; border-radius: 99px; font-size: 8px; font-weight: 800; text-transform: uppercase; letter-spacing: .5px; }
+.politics-support { color: #427653; background: #edf5eb; }
+.politics-neutral { color: #81704f; background: #f6f0e4; }
+.politics-opposition { color: #a14f47; background: #f9ece9; }
+.politics-influence { display: flex; justify-content: space-between; gap: 10px; margin-top: 13px; color: #75837a; font-size: 9px; }
+.politics-influence strong { color: var(--forest); font-size: 11px; }
+.politics-track { height: 6px; overflow: hidden; margin-top: 6px; border-radius: 99px; background: #edf0e9; }
+.politics-track span { display: block; height: 100%; border-radius: inherit; background: #789b75; }
+.politics-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px 13px; margin-top: 12px; }
+.politics-metrics div { display: flex; justify-content: space-between; gap: 8px; padding-bottom: 5px; border-bottom: 1px solid #edf0eb; font-size: 9px; }
+.politics-metrics span { color: #89958c; }
+.politics-metrics b { color: #4c6052; text-align: right; }
+.politics-measurement { min-height: 28px; margin: 10px 0 8px; color: #8b968e; font-size: 8px; line-height: 1.45; }
+.politics-interests { display: flex; flex-wrap: wrap; gap: 5px; }
+.politics-interests span { padding: 4px 7px; border-radius: 5px; color: #63776a; background: #f0f4ed; font-size: 8px; }
+.politics-data-note { margin: 0; padding: 11px 13px; border: 1px solid #e6e9e1; border-radius: 8px; color: #7d897f; background: #f8faf6; font-size: 9px; line-height: 1.5; }
