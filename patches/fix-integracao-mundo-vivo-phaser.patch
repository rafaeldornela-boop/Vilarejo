+.app-shell { min-height: 100vh; }
+.sidebar { width: 246px; position: fixed; inset: 0 auto 0 0; z-index: 20; display: flex; flex-direction: column; padding: 28px 18px 20px; color: #ecf1e9; background: var(--forest); }
+.brand { display: flex; align-items: center; gap: 12px; padding: 0 11px 38px; color: inherit; text-decoration: none; }
+.brand-mark { width: 35px; height: 35px; position: relative; display: block; transform: rotate(45deg); }
+.brand-mark span { position: absolute; width: 17px; height: 17px; border: 2px solid #d9b16e; border-radius: 4px; }
+.brand-mark span:nth-child(1) { top: 0; left: 0; }
+.brand-mark span:nth-child(2) { right: 0; top: 0; border-color: #98b99a; }
+.brand-mark span:nth-child(3) { bottom: 0; left: 9px; border-color: #f0e7d5; }
+.brand-copy { display: flex; flex-direction: column; line-height: 1.1; }
+.brand-copy strong { font: 800 22px var(--heading); letter-spacing: -.8px; }
+.brand-copy small { margin-top: 5px; color: #aebdb2; font-size: 10px; letter-spacing: 1.25px; text-transform: uppercase; }
