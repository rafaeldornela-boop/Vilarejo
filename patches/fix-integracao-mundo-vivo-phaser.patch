+.main-nav { display: grid; gap: 6px; }
+.nav-item { min-height: 46px; display: flex; align-items: center; gap: 13px; padding: 0 14px; border: 0; border-radius: 9px; color: #d0dbd1; background: transparent; text-align: left; font-size: 13px; font-weight: 600; transition: .18s ease; }
+.nav-item:hover { color: #fff; background: rgba(255,255,255,.07); }
+.nav-item.active { color: #fff; background: #315747; box-shadow: inset 3px 0 #d7b16e; }
+.nav-icon { width: 19px; text-align: center; color: #c5d4c8; font-size: 20px; line-height: 1; }
+.sidebar-bottom { margin-top: auto; }
+.season-card { display: flex; gap: 10px; align-items: center; padding: 13px 12px; border: 1px solid rgba(231,239,230,.13); border-radius: 10px; background: rgba(255,255,255,.055); }
+.season-icon { width: 31px; height: 31px; display: grid; place-items: center; border-radius: 9px; color: #f0cf92; background: rgba(201,152,79,.18); font-size: 18px; }
+.season-card div:last-child { display: flex; flex-direction: column; }
