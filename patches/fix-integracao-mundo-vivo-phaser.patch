+/* Experiência municipal: componentes novos escopados com ux-; módulos econômicos permanecem intactos. */
+.topbar { position: sticky; top: 0; z-index: 30; flex-wrap: wrap; gap: 8px 16px; }
+.topbar-right { flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
+.ux-time-controls { display: flex; flex-wrap: nowrap; align-items: center; gap: 5px; padding: 4px; border: 1px solid #dbe4d9; border-radius: 11px; background: rgba(255,255,255,.92); box-shadow: 0 3px 12px rgba(24,55,45,.07); }
+.ux-time-controls button { min-height: 34px; padding: 7px 10px; border-radius: 7px; font-size: 10px; }
+.ux-time-controls #reset { border: 1px solid #e6d8d4; background: #fff9f7; color: #8c4d44; }
+.ux-time-controls #reset:hover { background: #f9e9e4; }
