+.ux-overview-pulse { margin: 0 0 16px; padding: 19px 21px; border: 1px solid #dbe7dc; border-radius: 16px; background: linear-gradient(128deg, #f7faf5, #fff 70%); box-shadow: 0 5px 18px rgba(24,55,45,.055); }
+.ux-overview-pulse-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 13px; }
+.ux-overview-pulse-heading h2 { margin: 2px 0 0; color: #203f31; font: 800 1.14rem var(--heading); }
+.ux-period-chip { padding: 6px 10px; border: 1px solid #dce7d8; border-radius: 999px; background: #fff; color: #597363; font-size: .72rem; font-weight: 700; }
+.ux-overview-metrics { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 9px; }
+.ux-overview-metric { display: grid; align-content: start; gap: 5px; min-width: 0; min-height: 106px; padding: 13px; border: 1px solid #e3ebe2; border-radius: 11px; background: #fff; }
+.ux-overview-metric .eyebrow { margin: 0; color: #66796d; font-size: .64rem; }
+.ux-overview-metric strong { overflow-wrap: anywhere; color: #214635; font: 800 1.16rem var(--heading); }
+.ux-overview-metric small { color: #748177; font-size: .68rem; line-height: 1.35; }
+.ux-data-provenance { margin: 11px 1px 0; color: #77837a; font-size: .69rem; line-height: 1.4; }
+.ux-observation-empty { display: grid; gap: 5px; color: #5f7265; }
+.ux-observation-empty strong { color: #254637; font: 800 1.05rem var(--heading); }
+.ux-observation-empty p { margin: 0; font-size: .79rem; }
