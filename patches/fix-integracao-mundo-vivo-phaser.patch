+.map-layout { grid-template-columns: minmax(0, 2.2fr) minmax(250px, .78fr); }
+.map-stage { padding: 12px 18px 16px; }
+.village-map { max-height: min(68vh, 670px); min-height: 420px; }
+.map-district { cursor: pointer; transition: filter .16s ease, opacity .16s ease; }
+.map-district:hover, .map-district:focus-visible, .map-district.selected { filter: drop-shadow(0 0 7px rgba(28,89,57,.55)); }
