+/* Jornal do Vilarejo: estilo editorial elegante e estruturado */
+.newspaper-shell { display: grid; gap: 20px; color: #23342b; }
+.newspaper-nav-bar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 12px 16px; border: 1px solid #e1e8e2; border-radius: 12px; background: #fff; }
+.newspaper-nav-label { font-size: 0.76rem; font-weight: 700; color: #607468; text-transform: uppercase; letter-spacing: 0.05em; }
+.newspaper-edition-pill { padding: 6px 12px; border: 1px solid #cbdad0; border-radius: 999px; background: #f8faf8; color: #3d5648; font: inherit; font-size: 0.78rem; font-weight: 600; cursor: pointer; transition: all 0.15s ease; }
+.newspaper-edition-pill:hover { border-color: #2b5b46; background: #edf4ef; color: #1c3b2d; }
+.newspaper-edition-pill.active { border-color: #1e4535; background: #1e4535; color: #fff; }
+
+.newspaper-masthead { padding: 22px 24px; border: 2px solid #204334; border-radius: 14px; background: #fffdf9; text-align: center; }
+.newspaper-masthead-top { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #d4ded6; padding-bottom: 8px; margin-bottom: 12px; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.1em; color: #5a7264; }
+.newspaper-brand-title { margin: 6px 0 10px; font: 800 clamp(1.8rem, 3.5vw, 2.7rem) var(--heading); color: #18372d; letter-spacing: -0.02em; text-transform: uppercase; }
+.newspaper-masthead-meta { display: flex; justify-content: center; align-items: center; gap: 12px; flex-wrap: wrap; border-top: 1px solid #d4ded6; padding-top: 8px; font-size: 0.78rem; color: #52675b; }
+.newspaper-masthead-meta b { color: #1e4535; }
+
+.newspaper-frontpage { display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(280px, 1fr); gap: 18px; }
+.newspaper-lead-story { padding: 22px; border: 1px solid #e2eae3; border-radius: 14px; background: #fff; box-shadow: 0 4px 14px rgba(24, 55, 45, 0.04); }
+.newspaper-kicker { margin-bottom: 8px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #a14c3e; }
+.newspaper-headline { margin: 0 0 12px; font: 800 clamp(1.3rem, 2vw, 1.75rem) var(--heading); color: #18372d; line-height: 1.25; }
+.newspaper-lead-text { margin: 0 0 14px; font-size: 0.95rem; line-height: 1.6; color: #30483c; font-weight: 500; }
+.newspaper-body-copy { font-size: 0.88rem; line-height: 1.65; color: #475d50; border-top: 1px solid #edf2ee; padding-top: 14px; }
+
+.newspaper-highlights-box { padding: 18px; border: 1px solid #e0e9e2; border-radius: 14px; background: linear-gradient(135deg, #f7faf7, #ffffff); }
+.newspaper-highlights-title { margin-bottom: 12px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; color: #4b6656; border-bottom: 1px solid #dce6de; padding-bottom: 6px; }
+.newspaper-highlights-grid { display: grid; gap: 10px; }
+.newspaper-highlight-item { padding: 10px 12px; border: 1px solid #e5ede7; border-radius: 9px; background: #fff; }
+.newspaper-highlight-item small { display: block; font-size: 0.7rem; color: #6b7d72; text-transform: uppercase; }
+.newspaper-highlight-item strong { display: block; margin: 3px 0 2px; font: 800 1.2rem var(--heading); color: #1c4534; }
+.newspaper-highlight-item span { display: block; font-size: 0.7rem; color: #526f5d; }
+
+.newspaper-sections-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
+.newspaper-section-card { padding: 16px; border: 1px solid #e2eae3; border-radius: 12px; background: #fff; display: flex; flex-direction: column; gap: 8px; }
+.newspaper-section-badge { align-self: flex-start; padding: 4px 8px; border-radius: 6px; background: #edf4ef; color: #3b5c49; font-size: 0.68rem; font-weight: 800; text-transform: uppercase; }
+.newspaper-section-card h4 { margin: 0; font: 800 1.05rem var(--heading); color: #1c3b2e; }
+.newspaper-section-card p { margin: 0; font-size: 0.82rem; line-height: 1.55; color: #506659; }
+
+.newspaper-footer { padding: 14px 18px; border-top: 1px solid #e1e8e2; text-align: center; color: #76867d; font-size: 0.74rem; line-height: 1.5; }
+.newspaper-footer p { margin: 0; }
+
+@media (max-width: 900px) {
+  .newspaper-frontpage { grid-template-columns: 1fr; }
+  .newspaper-sections-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+@media (max-width: 640px) {
+  .newspaper-masthead { padding: 16px 14px; }
+  .newspaper-masthead-top { flex-direction: column; gap: 4px; text-align: center; }
+  .newspaper-sections-grid { grid-template-columns: 1fr; }
+}
